      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/products/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/collection/[anime]",
      "regex": "^/collection/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPanime": "nxtPanime"
      },
      "namedRegex": "^/collection/(?<nxtPanime>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
